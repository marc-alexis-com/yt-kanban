# Copy to .env and adjust. Everything is optional.

# Column where new videos land (and the only one the AI triage empties)
INBOX_THEME=Inbox

# AI triage ("Sort" button). Leave empty to disable it.
# Key from https://console.anthropic.com — one triage of ~20 videos costs well under a cent.
ANTHROPIC_API_KEY=
# TRIAGE_MODEL=claude-haiku-4-5

# Optional free-form sorting rules for the AI, in markdown (default: /data/triage-hints.md)
# TRIAGE_HINTS_FILE=/data/triage-hints.md
