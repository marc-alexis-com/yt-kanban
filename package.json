{
  "name": "yt-kanban",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted kanban of YouTube videos to watch, sorted by theme, with optional AI triage",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite --config web/vite.config.js",
    "dev:server": "node --watch server/index.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@fontsource-variable/roboto": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vue": "^3.5.43"
  }
}
